# Основные зависимости бота (TikTok comment bot с Playwright + Telegram)
aiogram==3.13.1                     # стабильная, можно оставить или обновить до ~3.14–3.20 если нужно новые фичи
aiosqlite==0.20.0                   # актуальная, проблем нет
playwright==1.48.0                  # хорошая версия, но если хостинг позволяет — попробуй 1.49+ для свежих фиксов
playwright-stealth==1.0.6           # последняя на момент, если есть обновления — можно проверить pip show
aiohttp==3.10.5                     # нормально, но 3.10.x — последняя серия без серьёзных breaking changes

# Для капчи (Capsolver)
python3-capsolver==1.2.0            # ← вот актуальная библиотека на 2026 год (не capsolver==1.2.0!)
                                    # старая capsolver 1.0.7 устарела, используй python3-capsolver

# Дополнительные полезные (необязательные, но рекомендую)
